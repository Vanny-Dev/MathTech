# ── MathTech frontend environment ──
# Copy to .env for local development. The real .env is gitignored, so it never
# reaches Vercel — set the value in the Vercel dashboard instead.
#
# IMPORTANT: Vite bakes VITE_* variables into the bundle at BUILD time.
# Changing it in Vercel does nothing until you REDEPLOY.

# Local:      http://localhost:5000/api
# Production: https://<your-backend>.onrender.com/api
# Include the /api suffix. No trailing slash.
VITE_API_URL=http://localhost:5000/api

# ── Google AdSense ──
# Your publisher id, e.g. ca-pub-1234567890123456. Get it from
# https://www.google.com/adsense under Account > Account information.
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Master switch for loading the real AdSense script and requesting ads.
# Keep this false for local development so you don't send real ad requests
# from localhost (AdSense can flag that as invalid traffic). Set to true only
# in the production build. The developer can still turn ads off at runtime
# from the Developer Dashboard regardless of this value.
VITE_ADS_ENABLED=false
