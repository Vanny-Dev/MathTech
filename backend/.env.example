# ── MathTech backend environment ──
# Copy to .env for local development. Never commit the real .env — it is gitignored.
# On Render / Railway, set these in the dashboard instead of uploading a file.

# 'development' or 'production'.
# IMPORTANT: must be 'production' when deployed — it is what stops the API from
# returning full stack traces in error responses (see middleware/errorHandler.js).
NODE_ENV=development

# Local only. Render and Railway inject their own PORT and the server already
# falls back to it (process.env.PORT || 5000), so do NOT set this in the host's
# dashboard — binding to the wrong port makes the deploy fail its health check.
PORT=5000

# Local:      mongodb://localhost:27017/digital_workbook
# Production: MongoDB Atlas SRV string, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/digital_workbook?retryWrites=true&w=majority
# URL-encode the password if it contains @ : / ? # [ ] or %
MONGO_URI=mongodb://localhost:27017/digital_workbook

# Signs and verifies login tokens (utils/generateToken.js, middleware/authMiddleware.js).
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value in production than locally. Changing it logs everyone out.
JWT_SECRET=change_me_use_a_long_random_string

# ── Seeded teacher account ──
# The teacher is created once on first start. Keep the real password OUT of the
# repository: set TEACHER_PASSWORD here locally and in the host's dashboard for
# production. Without it, the seeder refuses to create the account when
# NODE_ENV=production. The others are optional and have sensible defaults.
TEACHER_USERNAME=doriejean
TEACHER_PASSWORD=change_me_before_deploying
TEACHER_FULLNAME=Dorie Jean L. Justiniana
TEACHER_EMAIL=doriejean@gmail.com

# Allowed CORS origin (server.js). Must match the frontend's URL exactly —
# no trailing slash, and https:// in production.
# Local:      http://localhost:5173
# Production: https://mathtech-self.vercel.app
CLIENT_URL=http://localhost:5173
